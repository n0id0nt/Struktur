// Combat/Config/BattleCritter.wren
// The battle-side definition of one enemy type - the enemy counterpart to Combat/Config/BattlePlayer.wren.
// Everything a critter is in a fight lives here in one place: its fighting style (which supplies
// the move set - see Combat/Config/Archetype.wren), its HP / stamina pool, and how it looks and animates
// in the arena. Combat/Battler.wren turns one of these into a live entity + Combatant; CombatState
// looks a def up by species name when an encounter starts.
//
// "images and animations" reuse the overworld critter sheets for now - the frame ranges below
// mirror GameObjects/Chicken.wren / Chinlin.wren. Swap in battle-specific art (poses, hit/defeat
// frames) here and nothing else changes. `attributes` overrides single entries of the archetype's attribute
// baseline (Combat/Config/Archetype.wren; null = the baseline as is). `anims` keys Battler understands: "idle" (required),
// "attack", "hurt", "run" (see Combat/Config/ActionAnimations.wren for how they are used).
import "math" for Vec2
import "Combat/Combatant" for Combatant
import "Combat/Config/Archetype" for Archetype
import "Combat/Config/SheetAnims" for SheetAnims
import "GameObjects/NPC" for NPCData
import "Combat/Config/Moves" for Moves
import "Sprites/GoblinVikingBattleSprite" for GoblinVikingBattleSprite

class BattleCritter {
    // anims: { key: [startFrame, endFrameExclusive, seconds] }. facing: 1 = art faces right, -1 = left.
    construct new(name, archetypeName, maxHp, maxStamina, attributes, texturePath, cols, rows, pivot, facing, anims) {
        _name = name
        _attributes = attributes
        _archetypeName = archetypeName
        _maxHp = maxHp
        _maxStamina = maxStamina
        _texturePath = texturePath
        _cols = cols
        _rows = rows
        _pivot = pivot
        _facing = facing
        _anims = anims
        _animsLeft = null
        _kit = null
    }

    // Overrides the move set the archetype would give (e.g. the Training Dummy's lone Brace). Returns this, so a
    // def can be built and given its kit in one expression.
    withKit(moves) {
        _kit = moves
        return this
    }

    // Gives the def left-facing art: the same roles as `anims`, played (instead of flipping the sheet) while
    // the battler faces left. Returns this, like withKit.
    withLeftAnims(animsLeft) {
        _animsLeft = animsLeft
        return this
    }

    // The moves this fighter knows by default: its own kit if it has one, otherwise its archetype's.
    kit { _kit != null ? _kit : Archetype.byName(_archetypeName).kit }

    name { _name }
    archetypeName { _archetypeName }
    maxHp { _maxHp }
    maxStamina { _maxStamina }
    attributes { _attributes }
    texturePath { _texturePath }
    cols { _cols }
    rows { _rows }
    pivot { _pivot }
    facing { _facing }
    anims { _anims }
    animsLeft { _animsLeft }   // null = no left-facing art; Battler flips `anims` instead

    // A fresh Combatant (stats + move kit) for one instance of this critter. `entity` is the
    // overworld critter it came from (kept so a defeated one can be removed from the field).
    makeCombatant(entity) {
        var archetype = Archetype.byName(_archetypeName)
        return Combatant.new(_name, _maxHp, _maxStamina, archetype.attributesWith(_attributes), kit, entity)
    }

    static forName(name) {
        if (name == "Chinlin") {
            return BattleCritter.chinlin
        }
        if (name == "Villager") {
            return BattleCritter.villager
        }
        if (name == "Training Dummy") {
            return BattleCritter.trainingDummy
        }
        if (name == "Duelist") {
            return BattleCritter.duelist
        }
        return BattleCritter.chicken
    }

    // Sprites/chicken.png - 7x6 grid, 16px cells, pivot (8,8). See GameObjects/Chicken.wren.
    // anims: idle = wander_right, attack = peck_right, hurt = run_right (stand-in). Twitchy but feeble.
    static chicken {
        return BattleCritter.new("Chicken", "Speed", 45, 60, {"might": 6, "guard": 5, "precision": 8}, "Sprites/chicken.png", 7, 6, Vec2.new(8, 8), 1,
                                 {"idle": [6, 9, 0.5], "attack": [32, 39, 1.0], "hurt": [15, 18, 0.35], "run": [15, 18, 0.35]})
    }

    // Sprites/chinlin.png - 4x4 grid, 24px cells, pivot (12,16). See GameObjects/Chinlin.wren.
    // anims: idle = stand_right, attack / hurt = run_right (stand-in).
    static chinlin {
        return BattleCritter.new("Chinlin", "Power", 150, 55, null, "Sprites/chinlin.png", 4, 4, Vec2.new(12, 16), 1,
                                 {"idle": [4, 6, 0.8], "attack": [12, 15, 0.45], "hurt": [12, 15, 0.45], "run": [12, 15, 0.45]})
    }

    // --- NPC fighters ---------------------------------------------------------------
    // They wear their battle sheet (GameObjects/NPC.wren's NPCData.battleSprite - generated by 3dModelsToSprites,
    // left and right facing), with the same role -> clip mapping as the player (Combat/Config/SheetAnims.wren). They fight as party members
    // (Party/Party.wren - human controlled) or, for the Duelist, as the opponent you have to beat.

    // The Villager - a Control-style support fighter who joins the party after the locket quest.
    static villager { BattleCritter.fromNpc("Villager", "Control", 80, 70, null) }

    // The Duelist - a Speed-style fighter you must defeat in a duel to recruit. A trained fencer: reads and
    // turns aside attacks better than the player, is harder to parry back, and fights smart (focus - EnemyAI).
    static duelist {
        return BattleCritter.fromNpc("Duelist", "Speed", 100, 90, {"reflex": 16, "precision": 14, "focus": 13})
    }

    // --- test fighters -----------------------------------------------------------------

    // The Training Dummy (States/BattleTestState.wren): a punching bag for trying moves and stats. Effectively endless
    // HP, only ever Braces, and can't evade (agility 1) or parry (EnemyAI never parries for a fighter with no
    // attacks). Average guard and poise, so the damage and stagger it shows are a neutral baseline. Wears the
    // Guardian's generated battle sheet as placeholder art.
    static trainingDummy {
        return BattleCritter.fromSheet("Training Dummy", "Power", 9999, 999, {"agility": 1, "reflex": 1, "guard": 10, "poise": 10},
                                       GoblinVikingBattleSprite).withKit([Moves.brace])
    }

    // A def wearing the generated battle sheet of the NPC called `name`.
    static fromNpc(name, archetypeName, maxHp, maxStamina, attributes) {
        return BattleCritter.fromSheet(name, archetypeName, maxHp, maxStamina, attributes, NPCData.forName(name).battleSprite)
    }

    // A def wearing a generated battle sheet (a Sprites/<Name>BattleSprite class): right-facing anims plus the
    // left-facing ones, so Battler never has to mirror it.
    static fromSheet(name, archetypeName, maxHp, maxStamina, attributes, sheet) {
        var data = sheet.data
        var origin = data["origin"]
        var def = BattleCritter.new(name, archetypeName, maxHp, maxStamina, attributes, data["texture"], data["columns"],
                                    data["rows"], Vec2.new(origin[0], origin[1]), 1, SheetAnims.forSheet(data, "right", name))
        return def.withLeftAnims(SheetAnims.forSheet(data, "left", name))
    }
}
