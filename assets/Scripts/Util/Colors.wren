// Util/Colors.wren
// Named colours as RGBA Vec4s (0-255 per channel), for sprite tints, UI panels and text.
//
// The named colours are the 148 CSS named colors from the W3C's CSS Color Module Level 4, section 6.1 "Named
// Colors": https://www.w3.org/TR/css-color-4/#named-colors - same names (in capitals) and the same RGB values,
// all fully opaque, with no exceptions - so every colour here comes from that one list. (Note that in CSS
// DARKGRAY, 169, is lighter than GRAY, 128.)
// The only addition is BLANK (fully transparent), with TRANSPARENT as an alias.
//
// These are shared Vec4 objects - Vec4.copy one before changing it, or every user of the colour changes too.
import "math" for Vec4

// --- additions ---
var BLANK = Vec4.new(0, 0, 0, 0)
var TRANSPARENT = BLANK

// --- CSS named colors (W3C CSS Color Module Level 4) ---
