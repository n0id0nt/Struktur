<workout_file>
    <author>Struktur</author>
    <name>Sweet Spot 3x10</name>
    <description>Three 10-minute blocks just under threshold with 5 minutes easy between. A staple for building FTP.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="10" message="Easy start - spin it up gradually."/>
        </Warmup>
        <SteadyState Duration="600" Power="0.90" Cadence="90">
            <textevent timeoffset="0" message="Block 1 of 3. Smooth and steady."/>
            <textevent timeoffset="300" message="Halfway through this block."/>
        </SteadyState>
        <SteadyState Duration="300" Power="0.55"/>
        <SteadyState Duration="600" Power="0.90" Cadence="90">
            <textevent timeoffset="0" message="Block 2 of 3."/>
        </SteadyState>
        <SteadyState Duration="300" Power="0.55"/>
        <SteadyState Duration="600" Power="0.90" Cadence="90">
            <textevent timeoffset="0" message="Last block - hold it together."/>
        </SteadyState>
        <Cooldown Duration="480" PowerLow="0.65" PowerHigh="0.40">
            <textevent timeoffset="0" message="Done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
