<workout_file>
    <author>Struktur</author>
    <name>VO2 Max 5x3</name>
    <description>Five 3-minute efforts above threshold with equal recovery, then a free-ride spin and a sprint.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="480" PowerLow="0.40" PowerHigh="0.70"/>
        <SteadyState Duration="120" Power="0.85"/>
        <SteadyState Duration="120" Power="0.50"/>
        <IntervalsT Repeat="5" OnDuration="180" OffDuration="180" OnPower="1.15" OffPower="0.50" Cadence="95" CadenceResting="85">
            <textevent timeoffset="0" message="First effort - don't go out too hard."/>
            <textevent timeoffset="1440" message="Final effort. Empty the tank."/>
        </IntervalsT>
        <FreeRide Duration="300" FlatRoad="1">
            <textevent timeoffset="0" message="Free ride - spin easy at whatever feels good."/>
        </FreeRide>
        <MaxEffort Duration="20">
            <textevent timeoffset="0" message="Sprint!"/>
        </MaxEffort>
        <Cooldown Duration="360" PowerLow="0.60" PowerHigh="0.35"/>
    </workout>
</workout_file>
