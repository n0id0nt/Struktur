{
  "comment": "Ride HUD layouts (UI/Ride/RideLayout.wren explains every key). Positions are in the 1280x720 layout space; anchor is both where on the screen a panel attaches (0,0 top-left .. 1,1 bottom-right) and which point of the panel sits there. sizeClass L/M/S sets text and button sizes; everything inside a panel is laid out from its size. H in a ride cycles the layouts (order below); Ride Settings picks one too. The middle of the screen is where the rider is - keep it clear.",
  "default": "compact",
  "order": ["compact", "classic", "minimal"],
  "layouts": {
    "compact": {
      "panels": [
        { "widget": "tiles", "id": "top", "anchor": [0.5, 0], "position": [0, 8], "size": [820, 78], "sizeClass": "M",
          "tiles": ["power", "cadence", "heartRate", "speed", "grade", "target"] },
        { "widget": "workout", "anchor": [0, 1], "position": [8, -34], "size": [330, 150], "sizeClass": "S" },
        { "widget": "erg", "anchor": [1, 1], "position": [-8, -34], "size": [300, 110], "sizeClass": "S" },
        { "widget": "graph", "anchor": [0.5, 1], "position": [0, -34], "size": [440, 110], "sizeClass": "S" },
        { "widget": "status", "anchor": [0, 1], "position": [8, -6], "size": [560, 24], "sizeClass": "S" },
        { "widget": "hints", "anchor": [1, 1], "position": [-8, -6], "size": [700, 24], "sizeClass": "S" },
        { "widget": "cue", "anchor": [0.5, 0], "position": [0, 94], "size": [600, 40], "sizeClass": "M" },
        { "widget": "banner", "anchor": [0.5, 0.5], "position": [0, -130], "size": [520, 48], "sizeClass": "M" }
      ]
    },
    "classic": {
      "panels": [
        { "widget": "workout", "anchor": [0, 0], "position": [12, 12], "size": [330, 250], "sizeClass": "M" },
        { "widget": "tiles", "id": "main", "anchor": [0.5, 0], "position": [0, 12], "size": [540, 112], "sizeClass": "L",
          "tiles": ["cadence", "power", "heartRate"] },
        { "widget": "tiles", "id": "averages", "anchor": [0.5, 0], "position": [0, 128], "size": [540, 78], "sizeClass": "M",
          "tiles": ["averagePower", "speed", "averageSpeed"] },
        { "widget": "tiles", "id": "road", "anchor": [1, 0], "position": [-12, 12], "size": [300, 120], "sizeClass": "M",
          "tiles": ["grade", "climbed", "target"], "flow": "column" },
        { "widget": "erg", "anchor": [1, 0], "position": [-12, 136], "size": [300, 124], "sizeClass": "M" },
        { "widget": "graph", "anchor": [0.5, 1], "position": [0, -36], "size": [1000, 130], "sizeClass": "M" },
        { "widget": "status", "anchor": [0, 1], "position": [12, -6], "size": [560, 26], "sizeClass": "S" },
        { "widget": "hints", "anchor": [1, 1], "position": [-12, -6], "size": [700, 26], "sizeClass": "S" },
        { "widget": "cue", "anchor": [0.5, 0], "position": [0, 212], "size": [620, 44], "sizeClass": "M" },
        { "widget": "banner", "anchor": [0.5, 0.5], "position": [0, -60], "size": [560, 54], "sizeClass": "M" }
      ]
    },
    "minimal": {
      "panels": [
        { "widget": "tiles", "id": "rider", "anchor": [0, 0], "position": [8, 8], "size": [210, 120], "sizeClass": "S",
          "tiles": ["power", "cadence", "heartRate"], "flow": "column" },
        { "widget": "tiles", "id": "road", "anchor": [1, 0], "position": [-8, 8], "size": [210, 120], "sizeClass": "S",
          "tiles": ["speed", "grade", "target"], "flow": "column" },
        { "widget": "status", "anchor": [0.5, 0], "position": [0, 8], "size": [400, 24], "sizeClass": "S" },
        { "widget": "workout", "anchor": [0, 1], "position": [8, -8], "size": [290, 122], "sizeClass": "S" },
        { "widget": "erg", "anchor": [1, 1], "position": [-8, -8], "size": [290, 102], "sizeClass": "S" },
        { "widget": "cue", "anchor": [0.5, 0], "position": [0, 40], "size": [560, 36], "sizeClass": "S" },
        { "widget": "banner", "anchor": [0.5, 0.5], "position": [0, -130], "size": [480, 44], "sizeClass": "S" }
      ]
    }
  }
}
