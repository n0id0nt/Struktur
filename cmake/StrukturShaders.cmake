# struktur_add_shaders(<FunctionName> DIRECTORY <folder> SHADERS <name>... [VARYING <varying.def.sc>])
#
# Compiles the vs_<name>.sc / fs_<name>.sc pairs in <folder> into <folder>/compiled with bgfx's shaderc, and generates
# the C++ that embeds them: Struktur::Shaders::<FunctionName>(), a table for Renderer::RegisterEmbeddedShaders. A
# target uses it with struktur_use_shaders(<target> <FunctionName>).
#
# shaderc only runs in desktop builds. A web build embeds what a desktop build has already compiled, so build desktop
# once before building web from a clean checkout.
function(struktur_add_shaders function_name)
    cmake_parse_arguments(SHADERS "" "DIRECTORY;VARYING" "SHADERS" ${ARGN})
    if(NOT SHADERS_VARYING)
        set(SHADERS_VARYING ${SHADERS_DIRECTORY}/varying.def.sc)
    endif()
    set(output_directory ${SHADERS_DIRECTORY}/compiled)

    if(PLATFORM_DESKTOP)
        set(outputs)
        foreach(name IN LISTS SHADERS_SHADERS)
            foreach(stage IN ITEMS vs fs)
                if(stage STREQUAL "vs")
                    set(type VERTEX)
                else()
                    set(type FRAGMENT)
                endif()
                # DEBUG requests shaderc's --debug, so a GPU capture tool (RenderDoc) can show real source and step a
                # shader with named variables. Passed for every configuration: with a multi-config generator the
                # configuration isn't known here, and the extra information is small.
                bgfx_compile_shaders(
                    TYPE ${type}
                    SHADERS ${SHADERS_DIRECTORY}/${stage}_${name}.sc
                    VARYING_DEF ${SHADERS_VARYING}
                    INCLUDE_DIRS ${SHADERS_DIRECTORY}
                    OUTPUT_DIR ${output_directory}
                    OUT_FILES_VAR compiled
                    AS_HEADERS
                    DEBUG
                )
                list(APPEND outputs ${compiled})
            endforeach()
        endforeach()
        add_custom_target(struktur_shaders_${function_name} DEPENDS ${outputs})
    else()
        list(GET SHADERS_SHADERS 0 first)
        if(NOT EXISTS ${output_directory}/essl/vs_${first}.sc.bin.h)
            message(WARNING "${output_directory} is missing shaders - build for desktop once before building web, so "
                            "bgfx has compiled shaders to embed.")
        endif()
    endif()

    # The table, including each profile's headers as bgfx's BGFX_EMBEDDED_SHADER expects them.
    set(portable)
    set(windows)
    set(apple)
    set(entries)
    foreach(name IN LISTS SHADERS_SHADERS)
        foreach(stage IN ITEMS vs fs)
            set(file ${stage}_${name}.sc.bin.h)
            foreach(profile IN ITEMS essl glsl spirv)
                string(APPEND portable "#include \"${output_directory}/${profile}/${file}\"\n")
            endforeach()
            foreach(profile IN ITEMS dxbc dxil)
                string(APPEND windows "#include \"${output_directory}/${profile}/${file}\"\n")
            endforeach()
            string(APPEND apple "#include \"${output_directory}/metal/${file}\"\n")
            string(APPEND entries "\tBGFX_EMBEDDED_SHADER(${stage}_${name}),\n")
        endforeach()
    endforeach()
    string(CONCAT source
        "// Generated by struktur_add_shaders: the compiled shaders in ${SHADERS_DIRECTORY}\n"
        "// BGFX_PLATFORM_SUPPORTS_WGSL: bgfx would otherwise expect a wgsl profile on some platforms, which isn't\n"
        "// compiled.\n"
        "#define BGFX_PLATFORM_SUPPORTS_WGSL 0\n"
        "#include <bgfx/bgfx.h>\n"
        "#include <bgfx/embedded_shader.h>\n\n"
        "${portable}"
        "#if defined(_WIN32)\n${windows}#endif\n"
        "#if defined(__APPLE__)\n${apple}#endif\n\n"
        "static const bgfx::EmbeddedShader k_shaders[] = {\n${entries}\tBGFX_EMBEDDED_SHADER_END(),\n};\n\n"
        "namespace Struktur::Shaders\n{\n"
        "const bgfx::EmbeddedShader* ${function_name}()\n{\n\treturn k_shaders;\n}\n"
        "}  // namespace Struktur::Shaders\n")
    set(table ${CMAKE_BINARY_DIR}/shader_tables/${function_name}.cpp)
    # Only rewritten when the content changes, so configuring again doesn't recompile it.
    file(CONFIGURE OUTPUT ${table} CONTENT "${source}" @ONLY)
    set_property(GLOBAL PROPERTY STRUKTUR_SHADER_TABLE_${function_name} ${table})
endfunction()

# Compiles a shader table into <target>, after its shaders.
function(struktur_use_shaders target function_name)
    get_property(table GLOBAL PROPERTY STRUKTUR_SHADER_TABLE_${function_name})
    if(NOT table)
        message(FATAL_ERROR "struktur_use_shaders: struktur_add_shaders(${function_name} ...) hasn't been called")
    endif()
    target_sources(${target} PRIVATE ${table})
    source_group("Shaders" FILES ${table})
    if(TARGET struktur_shaders_${function_name})
        add_dependencies(${target} struktur_shaders_${function_name})
    endif()
endfunction()
